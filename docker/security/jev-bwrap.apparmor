# Candidate only. Do not load or deploy without parent/oracle approval.
# Rendered from the pinned Moby baseTemplate at ABI 3.0. Only the template's
# generic mount denial and generic umount allowance are replaced below.

# profile generated by github.com/moby/profiles/apparmor.
abi <abi/3.0>,
#include <tunables/global>

profile "jev-audit-bwrap" flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  # Moby's generator defaults an unknown daemon profile to "unconfined".
  # This explicit peer is a pre-deploy verification assumption.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer="unconfined",
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="jev-audit-bwrap",

  # bwrap: mount(NULL, "/", NULL, MS_SILENT|MS_SLAVE|MS_REC, NULL).
  mount options=(rslave,silent) -> /,

  # bwrap: tmpfs root at /tmp before the first pivot.
  mount fstype=tmpfs options=(nosuid,nodev) -> /tmp/,
  # bwrap: self-bind /tmp/newroot with MS_SILENT|MS_MGC_VAL|MS_BIND|MS_REC.
  mount options=(rbind) /tmp/newroot/ -> /tmp/newroot/,

  # bwrap setup_newroot fixed proc/dev/tmpfs operations after the first pivot.
  mount fstype=proc options=(nosuid,noexec,nodev) -> /newroot/proc/,
  mount fstype=tmpfs options=(nosuid,nodev) -> /newroot/dev/,
  mount fstype=tmpfs options=(nosuid,nodev) -> /newroot/tmp/,
  mount fstype=devpts options=(nosuid,noexec) -> /newroot/dev/pts/,

  # The only writable bind. The job id is exactly 32 lowercase hexadecimal
  # characters, matching runner._JOB_ID and no other data path.
  mount options=(rbind) /oldroot/data/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ -> /newroot/job/,

  # Fixed canonical sources after Path.resolve() and fixed runner targets.
  mount options=(rbind) /oldroot/usr/ -> /newroot/usr/,
  mount options=(rbind) /oldroot/usr/bin/ -> /newroot/bin/,
  mount options=(rbind) /oldroot/usr/lib/ -> /newroot/lib/,
  mount options=(rbind) /oldroot/usr/lib64/ -> /newroot/lib64/,
  mount options=(rbind) /oldroot/usr/share/fonts/ -> /newroot/usr/share/fonts/,
  mount options=(rbind) /oldroot/usr/local/share/fonts/ -> /newroot/usr/local/share/fonts/,
  mount options=(rbind) /oldroot/usr/local/ -> /newroot/usr/local/,
  mount options=(rbind) /oldroot/etc/fonts/ -> /newroot/etc/fonts/,
  mount options=(rbind) /oldroot/etc/hosts -> /newroot/etc/hosts,
  mount options=(rbind) /oldroot/etc/nsswitch.conf -> /newroot/etc/nsswitch.conf,
  mount options=(rbind) /oldroot/etc/resolv.conf -> /newroot/etc/resolv.conf,
  mount options=(rbind) /oldroot/etc/ssl/certs/ -> /newroot/etc/ssl/certs/,
  mount options=(rbind) /oldroot/usr/local/bin/ -> /newroot/usr/local/bin/,
  mount options=(rbind) /oldroot/app/jevseo/ -> /newroot/runtime/jevseo/,

  # --dev binds only these six fixed device nodes.
  mount options=(rbind) /oldroot/dev/null -> /newroot/dev/null,
  mount options=(rbind) /oldroot/dev/zero -> /newroot/dev/zero,
  mount options=(rbind) /oldroot/dev/full -> /newroot/dev/full,
  mount options=(rbind) /oldroot/dev/random -> /newroot/dev/random,
  mount options=(rbind) /oldroot/dev/urandom -> /newroot/dev/urandom,
  mount options=(rbind) /oldroot/dev/tty -> /newroot/dev/tty,

  # setup_newroot() covers the writable proc subdirectories with recursive
  # self-binds before bind_mount() applies the readonly remount.
  mount options=(rbind) /newroot/proc/sys/ -> /newroot/proc/sys/,
  mount options=(rbind) /newroot/proc/sysrq-trigger -> /newroot/proc/sysrq-trigger,
  mount options=(rbind) /newroot/proc/irq/ -> /newroot/proc/irq/,
  mount options=(rbind) /newroot/proc/bus/ -> /newroot/proc/bus/,

  # bind_mount() remounts readonly mounts with mandatory bind/remount/ro,
  # nosuid/nodev and silent bits. bind-mount.c permits only these optional
  # current mount flags: noexec, noatime, nodiratime, and relatime.
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/sys/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/sysrq-trigger,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/irq/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/bus/,
  remount options=(bind,remount,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/job/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/bin/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/lib/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/lib64/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/share/fonts/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/local/share/fonts/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/fonts/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/hosts,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/nsswitch.conf,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/resolv.conf,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/ssl/certs/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/local/bin/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/local/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/runtime/jevseo/,

  # bwrap: mount("oldroot", "oldroot", NULL,
  # MS_SILENT|MS_REC|MS_PRIVATE, NULL) after the first pivot.
  mount options=(rprivate,silent) -> /oldroot/,

  # bwrap's two fixed pivot_root calls: (base_path, oldroot), then (., .).
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,

  # bwrap calls umount2("oldroot", MNT_DETACH), then umount2(".", MNT_DETACH)
  # after fchdir(oldrootfd). Seccomp separately enforces MNT_DETACH only.
  umount /oldroot/,
  umount /,

  # Exact pinned Moby default profile inventory follows unchanged.
  # Host (privileged) processes may send signals to container processes.
  # signal (receive) peer=unconfined is above, per generator default.
  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="jev-audit-bwrap",
}
