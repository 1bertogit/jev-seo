# Candidate only. Parent/oracle review and the host AppArmor parser are required
# before this profile may be loaded. It is intentionally independent of Docker.
abi <abi/4.0>,
#include <tunables/global>

profile "jev-audit-native" flags=(attach_disconnected,mediate_deleted) {
  # Bubblewrap's source REQUIRED_CAPS set. systemd still supplies no host
  # capabilities; these rules do not add CAP_SYS_ADMIN to the service.
  # Source evidence: bubblewrap.c 7370ec86d0cc2cd3fa761d5839c7fe9ae714c6ca66f752c969204d62f2e0c10c
  # bind-mount.c 6092022e955c98fb7b3e616cea3bd1902968113e9869615f8ad0818448e6ecd5
  capability sys_admin,
  capability sys_chroot,
  capability net_admin,
  capability setuid,
  capability setgid,
  capability sys_ptrace,

  # The API, its inherited worker/render children, and the native egress probe
  # use only the socket families exercised by the reviewed code. nftables owns
  # destination policy for the three installed UIDs.
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  network unix seqpacket,
  deny network alg,
  deny network vsock,

  # The exact runner and native binary transitions inherit this profile.
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/bin/python rix,
  /usr/bin/bwrap rix,
  /usr/bin/prlimit rix,
  /bin/true rix,
  /usr/bin/true rix,
  /usr/bin/fc-list rix,
  /usr/sbin/ldconfig rix,

  # Copied venv, installed package, native configuration, and reviewed helper.
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/ r,
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/** r,
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/lib/** mr,
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/smokescreen.json r,
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/tools/check_sandbox_acceptance.py r,
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/tools/check_native_acceptance.py r,
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/requirements.lock r,
  /runtime/ r,
  /runtime/jevseo/ r,
  /runtime/jevseo/** r,

  # Canonical host runtime and read-only application inputs.
  /usr/** mr,
  /bin/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/share/fonts/** r,
  /usr/local/share/fonts/** r,
  /etc/fonts/** r,
  /etc/ssl/certs/** r,
  /var/cache/fontconfig/** r,
  /usr/share/zoneinfo/** r,
  /etc/ld.so.cache r,
  /etc/hosts r,
  /etc/hostname r,
  /etc/nsswitch.conf r,
  /etc/passwd r,
  /etc/group r,
  /etc/gai.conf r,
  /etc/host.conf r,
  /etc/services r,
  /etc/protocols r,
  /etc/localtime r,
  /etc/resolv.conf r,
  /run/systemd/resolve/stub-resolv.conf r,

  # Bubblewrap and the acceptance probe use only lexical self paths plus
  # resolved numeric process paths. Maps are opened read/write by bwrap.
  /proc/ r,
  /proc/self/ r,
  /proc/[0-9]*/ r,
  /proc/self/ns/ r,
  /proc/[0-9]*/ns/ r,
  /proc/self/ns/{mnt,user,pid,ipc,uts,net,cgroup} r,
  /proc/[0-9]*/ns/{mnt,user,pid,ipc,uts,net,cgroup} r,
  /proc/self/status r,
  /proc/[0-9]*/status r,
  /proc/self/attr/ r,
  /proc/[0-9]*/attr/ r,
  /proc/self/attr/current r,
  /proc/[0-9]*/attr/current r,
  /proc/self/mountinfo r,
  /proc/[0-9]*/mountinfo r,
  /proc/self/fd/ r,
  /proc/[0-9]*/fd/ r,
  /proc/self/fd/[0-9]* r,
  /proc/[0-9]*/fd/[0-9]* r,
  /oldroot/proc/[0-9]*/fd/[0-9]* r,
  /proc/sys/kernel/overflowuid r,
  /proc/sys/kernel/overflowgid r,
  /proc/sys/user/max_user_namespaces r,
  /proc/[0-9]*/uid_map rw,
  /proc/[0-9]*/gid_map rw,
  /proc/[0-9]*/setgroups rw,
  ptrace (read,readby) peer="jev-audit-native",

  # Six fixed device nodes used by --dev, plus private temporary files.
  /dev/null rw,
  /dev/zero r,
  /dev/full r,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /tmp/ rw,
  /tmp/** rwk,
  /tmp/oldroot/ rw,
  /tmp/oldroot/** rwk,
  /tmp/newroot/ rw,
  /tmp/newroot/** rwk,

  # get_oldroot_path()/get_file_mode() may inspect only these finite bind
  # sources before setup_newroot() performs the reviewed mounts.
  /oldroot/var/lib/jev-audit-native/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ r,
  /oldroot/var/lib/jev-audit-native/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/** r,
  /oldroot/var/lib/jev-audit-native-acceptance/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ r,
  /oldroot/var/lib/jev-audit-native-acceptance/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/** r,
  /oldroot/usr/ r,
  /oldroot/usr/bin/ r,
  /oldroot/usr/lib/ r,
  /oldroot/usr/lib64/ r,
  /oldroot/usr/share/fonts/ r,
  /oldroot/usr/local/share/fonts/ r,
  /oldroot/etc/fonts/ r,
  /oldroot/etc/hosts r,
  /oldroot/etc/nsswitch.conf r,
  /oldroot/run/systemd/resolve/stub-resolv.conf r,
  /oldroot/etc/ssl/certs/ r,
  /oldroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/ r,
  /oldroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/bin/ r,
  /oldroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/lib/python3.12/site-packages/jevseo/ r,
  /oldroot/dev/null r,
  /oldroot/dev/zero r,
  /oldroot/dev/full r,
  /oldroot/dev/random r,
  /oldroot/dev/urandom r,
  /oldroot/dev/tty r,

  # setup_newroot() creates only these fixed destination parents, files,
  # device nodes, symlinks, and proc cover directories; no recursive new-root rule.
  / r,
  /newroot/ r,
  /newroot/proc/ rw,
  /newroot/dev/ rw,
  /newroot/tmp/ rw,
  /newroot/etc/ rw,
  /newroot/runtime/ rw,
  /newroot/job/ rw,
  /newroot/usr/ rw,
  /newroot/bin/ rw,
  /newroot/lib/ rw,
  /newroot/lib64/ rw,
  /newroot/opt/ rw,
  /newroot/etc/fonts/ rw,
  /newroot/etc/ssl/ rw,
  /newroot/etc/ssl/certs/ rw,
  /newroot/etc/hosts rw,
  /newroot/etc/nsswitch.conf rw,
  /newroot/etc/resolv.conf rw,
  /newroot/runtime/jevseo/ rw,
  /newroot/opt/jev-audit-native/ rw,
  /newroot/opt/jev-audit-native/releases/ rw,
  /newroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/ rw,
  /newroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/ rw,
  /newroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/bin/ rw,
  /newroot/usr/share/ rw,
  /newroot/usr/share/fonts/ rw,
  /newroot/usr/local/ rw,
  /newroot/usr/local/share/ rw,
  /newroot/usr/local/share/fonts/ rw,
  /newroot/proc/sys/ rw,
  /newroot/proc/sysrq-trigger rw,
  /newroot/proc/irq/ rw,
  /newroot/proc/bus/ rw,
  /newroot/dev/null rw,
  /newroot/dev/zero rw,
  /newroot/dev/full rw,
  /newroot/dev/random rw,
  /newroot/dev/urandom rw,
  /newroot/dev/tty rw,
  /newroot/dev/stdin rw,
  /newroot/dev/stdout rw,
  /newroot/dev/stderr rw,
  /newroot/dev/fd rw,
  /newroot/dev/core rw,
  /newroot/dev/ptmx rw,
  /newroot/dev/pts/ rw,
  /newroot/dev/shm/ rw,

  # API and acceptance data. The only variable path is one lowercase
  # hexadecimal job identifier, exactly 32 characters long.
  /var/lib/jev-audit-native/ r,
  /var/lib/jev-audit-native/jobs/ rw,
  /var/lib/jev-audit-native/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ rw,
  /var/lib/jev-audit-native/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/** rwk,
  /var/lib/jev-audit-native/jobs.sqlite3 rwk,
  /var/lib/jev-audit-native/jobs.sqlite3-journal rwk,
  /var/lib/jev-audit-native/jobs.sqlite3-wal rwk,
  /var/lib/jev-audit-native/jobs.sqlite3-shm rwk,
  /var/lib/jev-audit-native/worker.lock rwk,
  /var/lib/jev-audit-native-acceptance/ r,
  /var/lib/jev-audit-native-acceptance/.acceptance-outer-secret rwk,
  /var/lib/jev-audit-native-acceptance/jobs.sqlite3 rwk,
  /var/lib/jev-audit-native-acceptance/jobs/ rw,
  /var/lib/jev-audit-native-acceptance/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ rw,
  /var/lib/jev-audit-native-acceptance/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/** rwk,

  # A finite canary write is allowed to reach a read-only bind and return
  # EROFS; no release/runtime tree write rule exists.
  /runtime/jevseo/.jev-acceptance-ro-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] w,
  /opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/.jev-acceptance-ro-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] w,
  /job/ rw,
  /job/** rwk,

  # Only this service and PID 1 may signal the inherited worker tree.
  signal (send,receive) peer="jev-audit-native",
  signal (receive) peer=unconfined,

  # User namespaces are explicit and local to this profile. No transition to
  # another profile or unconfined execution is permitted.
  userns,

  # Bubblewrap 0.9.0 mount/pivot contract, derived from the pinned source.
  mount options=(rslave,silent) -> /,
  mount fstype=tmpfs options=(nosuid,nodev) -> /tmp/,
  mount options=(rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount fstype=proc options=(nosuid,noexec,nodev) -> /newroot/proc/,
  mount fstype=tmpfs options=(nosuid,nodev) -> /newroot/dev/,
  mount fstype=tmpfs options=(nosuid,nodev) -> /newroot/tmp/,
  mount fstype=devpts options=(nosuid,noexec) -> /newroot/dev/pts/,
  mount options=(rbind) /oldroot/var/lib/jev-audit-native/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ -> /newroot/job/,
  mount options=(rbind) /oldroot/var/lib/jev-audit-native-acceptance/jobs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ -> /newroot/job/,
  mount options=(rbind) /oldroot/usr/ -> /newroot/usr/,
  mount options=(rbind) /oldroot/usr/bin/ -> /newroot/bin/,
  mount options=(rbind) /oldroot/usr/lib/ -> /newroot/lib/,
  mount options=(rbind) /oldroot/usr/lib64/ -> /newroot/lib64/,
  mount options=(rbind) /oldroot/usr/share/fonts/ -> /newroot/usr/share/fonts/,
  mount options=(rbind) /oldroot/usr/local/share/fonts/ -> /newroot/usr/local/share/fonts/,
  mount options=(rbind) /oldroot/etc/fonts/ -> /newroot/etc/fonts/,
  mount options=(rbind) /oldroot/etc/hosts -> /newroot/etc/hosts,
  mount options=(rbind) /oldroot/etc/nsswitch.conf -> /newroot/etc/nsswitch.conf,
  mount options=(rbind) /oldroot/run/systemd/resolve/stub-resolv.conf -> /newroot/etc/resolv.conf,
  mount options=(rbind) /oldroot/etc/ssl/certs/ -> /newroot/etc/ssl/certs/,
  mount options=(rbind) /oldroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/ -> /newroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/,
  mount options=(rbind) /oldroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/bin/ -> /newroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/bin/,
  mount options=(rbind) /oldroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/lib/python3.12/site-packages/jevseo/ -> /newroot/runtime/jevseo/,
  mount options=(rbind) /oldroot/dev/null -> /newroot/dev/null,
  mount options=(rbind) /oldroot/dev/zero -> /newroot/dev/zero,
  mount options=(rbind) /oldroot/dev/full -> /newroot/dev/full,
  mount options=(rbind) /oldroot/dev/random -> /newroot/dev/random,
  mount options=(rbind) /oldroot/dev/urandom -> /newroot/dev/urandom,
  mount options=(rbind) /oldroot/dev/tty -> /newroot/dev/tty,
  mount options=(rbind) /newroot/proc/sys/ -> /newroot/proc/sys/,
  mount options=(rbind) /newroot/proc/sysrq-trigger -> /newroot/proc/sysrq-trigger,
  mount options=(rbind) /newroot/proc/irq/ -> /newroot/proc/irq/,
  mount options=(rbind) /newroot/proc/bus/ -> /newroot/proc/bus/,

  # bind_mount() mandatory flags plus only source-observed optional flags.
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/sys/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/sysrq-trigger,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/irq/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/proc/bus/,
  remount options=(bind,remount,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/job/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/bin/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/lib/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/lib64/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/share/fonts/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/usr/local/share/fonts/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/fonts/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/hosts,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/nsswitch.conf,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/resolv.conf,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/etc/ssl/certs/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/opt/jev-audit-native/releases/0e7c53a36257c75d96aae7890f2103b9341c9e3b/venv/bin/,
  remount options=(bind,remount,ro,nosuid,nodev,silent) options in (noexec,noatime,nodiratime,relatime) /newroot/runtime/jevseo/,

  mount options=(rprivate,silent) -> /oldroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
  umount /oldroot/,
  umount /,

  # Do not read secrets, home directories, or other application data.
  deny /etc/jev-audit-native/** rwklx,
  deny /root/** rwklx,
  deny /home/** rwklx,
  deny /data/** rwklx,
}
